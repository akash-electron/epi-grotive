# Shared MongoDB (the admin app uses the same database)
#   content     { _id: "site", data: { <section>: ... } }  edited by the admin app
#   submissions { name, email, message, createdAt, ip, userAgent, read }  written by /api/contact
MONGODB_URI=
MONGODB_DB=epigrotive
# The admin app calls POST /api/revalidate with header x-revalidate-secret after each save
REVALIDATE_SECRET=
